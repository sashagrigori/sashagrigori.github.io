<Fragment slot="scripts"><script is:inline>
const two = i => String(i).padStart(2,"0");
// starburst tags: 16-point star polygon
const star = (n=16, r=.5, ri=.36) => "polygon(" + Array.from({length:n*2},(_,k)=>{ const a=Math.PI*k/n, rr=k%2?ri:r; return `${50+Math.cos(a)*rr*100}% ${50+Math.sin(a)*rr*100}%`; }).join(",") + ")";
const secs=[...document.querySelectorAll("section.ch")], toc=document.getElementById("toc");
toc.innerHTML = secs.map((s,i)=>`<li><a href="#${s.id}"><span class="n">${two(i+1)}</span>${s.dataset.t}</a></li>`).join("");
const links=[...toc.querySelectorAll("a")], main=document.getElementById("main");
function sync(){ let k=0; secs.forEach((s,i)=>{ if(s.getBoundingClientRect().top < innerHeight*.35) k=i; }); links.forEach((a,i)=>a.classList.toggle("on",i===k));
  const r=main.getBoundingClientRect(); document.getElementById("prog").style.width=Math.min(100,Math.max(0,(innerHeight*.35-r.top)/r.height*100))+"%"; }
addEventListener("scroll",sync,{passive:true}); sync();
// scale the 1440-wide live site down to the window; on a phone show the site's own phone version at full size
const win=document.querySelector(".win.live"), frame=win.querySelector("iframe");
function fitFrame(){
  if (matchMedia("(max-width:900px)").matches) { frame.style.width=win.clientWidth+"px"; frame.style.transform="none"; frame.style.height=win.clientHeight+"px"; return; }
  const s=win.clientWidth/1440; frame.style.width="1440px"; frame.style.transform=`scale(${s})`; frame.style.height=(win.clientHeight/s)+"px"; }
addEventListener("resize",fitFrame); fitFrame();
</script></Fragment>
