    <div class="pair">
      <figure><img src="/img/slepok/form2.webp" alt="" loading="lazy"><figcaption class="cap"><span class="lab mut">Заявка</span><br>Вид услуги из&nbsp;списка, имя, телефон и&nbsp;почта</figcaption></figure>
