<div class="info" data-native><div class="mrow"><div class="n mono" id="in"></div><div class="mnav"><button class="marr" type="button" data-d="-1" aria-label="предыдущая работа"></button><div class="mdots" id="mdots"></div><button class="marr" type="button" data-d="1" aria-label="следующая работа"></button></div></div><div class="t" id="it"></div><div class="d" id="id"></div><div class="g mono" id="ig"></div><a class="go" id="igo" href="#">Смотреть кейс&nbsp;→</a></div>
