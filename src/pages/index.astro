<Fragment slot="scripts"><script is:inline>
const root=document.documentElement; root.dataset.l="toc"; root.dataset.f="ptn"; root.classList.add("narrow");
const ph = (t, bg, fg) => "data:image/svg+xml;utf8," + encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="900"><rect width="100%" height="100%" fill="${bg}"/><text x="60" y="820" font-family="PT Sans Narrow, Arial Narrow, sans-serif" font-size="150" font-weight="700" fill="${fg}" letter-spacing="-4">${t}</text><text x="64" y="110" font-family="PT Sans Narrow, sans-serif" font-size="34" fill="${fg}" opacity=".6">ОБЛОЖКА-ЗАГЛУШКА</text></svg>`);
const GROUPS = { prod:"UX/UI", id:"Айдентика и графика" };
const ALL = [
  { grp:"prod", t:"Напоказ", d:"Дневник культурного опыта: от 8 интервью до живого сервиса", g:"Продукт / UX/UI — 2026", cover:"/img/home/napokaz-cov.webp", ui:"/img/home/napokaz-x.webp", ar:1920/1234, href:"/napokaz/" },
  { grp:"prod", t:"The Rose Girl", d:"Сайт фанатской манги на пяти языках", g:"UX/UI / разработка — 2026", cover:"/img/home/manga-cov.webp", ui:"/img/home/manga-x.webp", ar:1272/1146, href:"/manga/" },
  { grp:"prod", t:"Praktika.school", d:"iOS-приложение онлайн-школы", g:"UX/UI / EdTech — 2024", cover:"/img/b1.jpg", ui:"/img/home/praktika-x.webp", ar:808/632, href:"/praktika/" },
  { grp:"prod", t:"Слепок", d:"Лендинг керамической студии: от исследования и бренда до живого сайта", g:"UX/UI / бренд — 2026", cover:"/img/b2.jpg", ui:"/img/home/slepok-x.webp", ar:808/632, href:"/slepok-case/" },
  { grp:"id", t:"Кино и кофе", d:"Айдентика кофейни-кинотеатра / визуальная основа сервиса «Напоказ»", g:"Айдентика / web — 2026", cover:"/img/b3.jpg", ui:"/img/home/kino-x.webp", ar:808/632, href:"/kino/" },
  { grp:"id", t:"Чердак Бардак", d:"Визуал соцсетей творческой мастерской в Нови-Саде", g:"SMM-дизайн / гайд — 2026", cover:"/img/home/cherdak-cov.webp", ui:"/img/home/cherdak-x.webp", ar:1, href:"/cherdak/" },
  { grp:"id", t:"alё", d:"Айдентика собственного бренда вязаных вещей", g:"Айдентика / бренд — 2024", cover:"/img/home/ale-cov.webp", ui:"/img/ale/grid.webp", ar:2675/1920, href:"/ale/" },
  { grp:"id", t:"Коммуналка", d:"Две концепции визуала для книжного фестиваля", g:"Айдентика / соцсети — 2025", cover:"/img/komm/k1-poster.webp", ui:"/img/komm/k2-poster1.webp", ar:1206/1589, href:"/kommunalka/" },
];
const year = p => (p.g.split("— ")[1]||"—");
const byGrp = g => ALL.filter(p=>p.grp===g);
const LIST = ALL;
const stage=document.getElementById("stage"), toc=document.getElementById("toc"), tochead=document.getElementById("tochead");
let ty="board", cards=[], rows=[], pos=0, target=0, shown=-1, idle=0, curGrp=null;

// split-flap: letters run through random glyphs and settle left to right
const GLYPHS="АБВГДЕЖЗИКЛМНОПРСТУФХЦЧШЭЮЯ0123456789";
function flip(el, text, dur=520){
  if(ty!=="board"){ el.textContent=text; return; }
  const t0=performance.now(); cancelAnimationFrame(el._f);
  const step=now=>{ const k=Math.min(1,(now-t0)/dur);
    el.textContent=[...text].map((c,i)=> c===" " || i/text.length < k ? c : GLYPHS[Math.random()*GLYPHS.length|0]).join("");
    if(k<1) el._f=requestAnimationFrame(step); };
  el._f=requestAnimationFrame(step);
}
const M=matchMedia("(max-width:900px)");
cards=LIST.map((p,i)=>{ const c=document.createElement("div"); c.className="card"; c.innerHTML=cover(p);
  c.onclick=()=>{ if(window.__dragged) return; if(Math.round(pos)!==i) target=i; else if(p.href) location.href=p.href; else toast(`Здесь откроется кейс «${p.t}»`); }; stage.append(c); return c; });

function drawList(g){
  curGrp=g; root.classList.toggle("dark", g==="id");
  tochead.innerHTML=`<div class="tabs mono">${["prod","id"].map(x=>`<button data-t="${x}" class="${x===g?"on":""}"><span data-r="${x==="prod"?"I":"II"}" data-n="${byGrp(x).length}">${x==="prod"?"UX/UI":(ty==="mix"&&x===g?"айдентика":"Айдентика")}</span><sup>${byGrp(x).length}</sup></button>`).join("")}</div>`;
  tochead.querySelectorAll("button").forEach(b=>b.onclick=()=>{ target=LIST.findIndex(p=>p.grp===b.dataset.t); });
  const active=tochead.querySelector("button.on span"); flip(active, active.textContent, 420);
  const items=LIST.map((p,i)=>({p,i})).filter(o=>o.p.grp===g);
  toc.innerHTML=items.map(({p,i},n)=>`<div class="row" data-i="${i}"><span class="no">${String(n+1).padStart(2,"0")}</span><span>${p.t}</span><span class="lead"></span><span class="yr">${year(p)}</span><span class="ar">→</span></div>`).join("");
  rows=[...toc.querySelectorAll(".row")]; rows.forEach(r=>r.onclick=()=>target=+r.dataset.i);
  // background word slides out / in
  const bw=document.getElementById("bgw"), next=g==="prod"?"UX/UI":"Айдентика";
  if(bw.textContent!==next){ bw.classList.add("out"); setTimeout(()=>{ bw.textContent=next; bw.classList.remove("out"); bw.classList.add("in"); requestAnimationFrame(()=>requestAnimationFrame(()=>bw.classList.remove("in"))); },380); }
}
const H=()=>Math.min(innerHeight*.5, 480, innerWidth*.26);
// on a phone each cover fits the stage on its own: wide ones by width, tall ones by height
const hOf=i=>M.matches ? Math.min(stage.clientHeight*.78, stage.clientWidth*.86/LIST[i].ar) : H();
function size(){ cards.forEach((c,i)=>{ const h=hOf(i), w=h*LIST[i].ar; c.style.height=h+"px"; c.style.width=w+"px"; c.style.marginLeft=(-w/2)+"px"; c.style.marginTop=(-h/2)+"px"; }); }
size(); addEventListener("resize",size); M.addEventListener("change",()=>shown=-1);
// on a narrow screen the page itself scrolls, so the wheel flips works only over the stack
addEventListener("wheel",e=>{ if(M.matches && !e.target.closest(".stage")) return; e.preventDefault(); target+=e.deltaY/420; idle=0; },{passive:false});
addEventListener("keydown",e=>{ if(e.key==="ArrowDown"||e.key==="ArrowRight") target++; if(e.key==="ArrowUp"||e.key==="ArrowLeft") target--; });
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
function diag(o){ if(M.matches) return diagPhone(o); const a=Math.abs(o), m=Math.min(a,1), s=Math.sign(o), step=26;
  const x=o*step*.7 + s*m*innerWidth*.07, y=-o*step*.75 - s*m*innerHeight*.15;
  return { tf:`translate3d(${x}px,${y}px,${-a*40+(1-m)*60}px) rotateY(${-38*m*s}deg) rotateX(${12*m}deg) rotateZ(${-6*m*s}deg) scale(${1-m*.32})`, z:100-Math.round(a*10), op:a>7?0:1 }; }
// the same diagonal, measured by the stage instead of the window
function diagPhone(o){ const a=Math.abs(o), m=Math.min(a,1), s=Math.sign(o), sw=stage.clientWidth, sh=stage.clientHeight;
  // the whole stack sits a bit high, and past covers drop less than the next ones rise, so less hangs over the tabs
  const x=o*14+s*m*sw*.16, y=-o*12-s*m*sh*(s>0?.2:.13)-sh*.03;
  return { tf:`translate3d(${x}px,${y}px,${-a*30+(1-m)*40}px) rotateY(${-34*m*s}deg) rotateX(${10*m}deg) rotateZ(${-6*m*s}deg) scale(${1-m*.34})`, z:100-Math.round(a*10), op:a>5?0:1 }; }
// phone: swipe left = next work; a swipe doesn't count as a tap on a cover.
// The direction is decided after the first few pixels: clearly sideways (under ~40° from horizontal) — the stack moves
// and the page stays put; down or diagonal — the page scrolls and the stack doesn't budge
let drag=null;
const SIDEWAYS=1.2;
function dragStart(x,y){ if(M.matches) drag={x,y,t:target,axis:null}; }
function dragMove(x,y,e){ if(!drag) return;
  const dx=x-drag.x, dy=y-drag.y;
  if(!drag.axis){ if(Math.hypot(dx,dy)<10) return; drag.axis=Math.abs(dx)>Math.abs(dy)*SIDEWAYS?"x":"y"; }
  if(drag.axis!=="x") return;
  if(e && e.cancelable) e.preventDefault();
  window.__dragged=true; target=drag.t-dx/(stage.clientWidth*.5); idle=0; }
function dragEnd(){ if(!drag) return;
  // even a short confident swipe turns one work; a tiny one springs back
  if(drag.axis==="x"){ const d=target-drag.t; target=drag.t+(Math.abs(d)>.12 ? Math.sign(d)*Math.max(1,Math.round(Math.abs(d))) : 0); }
  drag=null; setTimeout(()=>window.__dragged=false,350); }
stage.addEventListener("touchstart",e=>{ if(e.touches.length>1){ drag=null; return; } const t=e.touches[0]; dragStart(t.clientX,t.clientY); },{passive:true});
stage.addEventListener("touchmove",e=>{ const t=e.touches[0]; dragMove(t.clientX,t.clientY,e); },{passive:false});
stage.addEventListener("touchend",dragEnd); stage.addEventListener("touchcancel",dragEnd);
// a mouse in a narrow desktop window drags the same way
stage.addEventListener("pointerdown",e=>{ if(e.pointerType==="mouse") dragStart(e.clientX,e.clientY); });
addEventListener("pointermove",e=>{ if(e.pointerType==="mouse") dragMove(e.clientX,e.clientY); });
addEventListener("pointerup",e=>{ if(e.pointerType==="mouse") dragEnd(); });
const dots=document.getElementById("mdots"); dots.innerHTML=LIST.map(()=>"<i></i>").join("");
// arrows, so it's obvious the stack turns; chosen: c — arrows only, no dots (the tabs already say how many); a and b kept for comparison
root.dataset.arr=new URLSearchParams(location.search).get("arr")||"c";
const arrow=d=>`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d<0?"M19 12H5M11 6l-6 6 6 6":"M5 12h14M13 6l6 6-6 6"}"/></svg>`;
stage.insertAdjacentHTML("beforeend",`<button class="sarr" type="button" data-d="-1" aria-label="предыдущая работа"></button><button class="sarr" type="button" data-d="1" aria-label="следующая работа"></button>`);
const arrows=[...document.querySelectorAll(".marr,.sarr")];
arrows.forEach(b=>{ b.innerHTML=arrow(+b.dataset.d); b.onclick=e=>{ e.stopPropagation(); target=clamp(Math.round(target)+ +b.dataset.d,0,LIST.length-1); idle=0; }; });
document.getElementById("mwrite").onclick=e=>{ const r=e.currentTarget.getBoundingClientRect(); openContacts(r.left+100, r.top+19); };
const wfill=document.getElementById("wfill");
(function loop(){
  target=clamp(target,0,LIST.length-1); if(++idle>18){ const r=Math.round(target); target+=(r-target)*.2; }
  pos+=(target-pos)*.1;
  cards.forEach((c,i)=>{ const r=diag(i-pos); c.style.transform=r.tf; c.style.zIndex=r.z; c.style.opacity=r.op; });
  const k=Math.round(pos); if(k!==shown){ shown=k; const p=LIST[k];
    if(p.grp!==curGrp) drawList(p.grp);
    const n=LIST.filter((q,j)=>j<=k && q.grp===p.grp).length;
    // on a phone the group is already in the tabs right above, so the counter shows «01 / 04»
    document.getElementById("in").textContent=`${String(n).padStart(2,"0")} / ${M.matches ? String(byGrp(p.grp).length).padStart(2,"0") : GROUPS[p.grp]}`;
    flip(document.getElementById("it"), p.t); document.getElementById("id").textContent=p.d; document.getElementById("ig").textContent=p.g;
    document.getElementById("igo").href=p.href;
    dots.querySelectorAll("i").forEach((d,j)=>d.classList.toggle("on",j===k));
    arrows.forEach(b=>b.classList.toggle("off", +b.dataset.d<0 ? k===0 : k===LIST.length-1));
    rows.forEach(r=>r.classList.toggle("on",+r.dataset.i===k)); }
  requestAnimationFrame(loop); })();
function setTy(t){ ty=t; root.dataset.ty=t; if(curGrp) drawList(curGrp); shown=-1; }
document.querySelectorAll(".switch a[data-ty]").forEach(a=>a.onclick=e=>{ e.preventDefault(); setTy(a.dataset.ty); });
setTy("min");
</script></Fragment>
