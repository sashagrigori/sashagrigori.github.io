<Fragment slot="scripts"><script is:inline>
const two = i => String(i).padStart(2,"0");
const WF=[["login","Sign-in","Social login on top, phone and email below"],["home","Home","My courses: in progress, favorites, completed"],["catalog","Catalog","Price, rating, author and a favorite button on the card"],["filter","Filter","Topic, price and rating"],["course","Course page","Progress stats and a start button"],["lesson","Lesson","Comments, summary, timestamped notes and homework"],["profile","Profile","Subscription, activity calendar and streak"],["cert","Certificate","The course result, downloadable as a file"]];
document.getElementById("wfgrid").innerHTML = WF.map(([k,t,d])=>`<figure><img src="/img/praktika/wfs-${k}.webp" alt="" loading="lazy"><figcaption><b>${t}</b>${d}</figcaption></figure>`).join("");
const secs=[...document.querySelectorAll("section.ch")], toc=document.getElementById("toc");
toc.innerHTML = secs.map((s,i)=>`<li><a href="#${s.id}"><span class="n">${two(i+1)}</span>${s.dataset.t}</a></li>`).join("");
const links=[...toc.querySelectorAll("a")], main=document.getElementById("main");
function sync(){ let k=0; secs.forEach((s,i)=>{ if(s.getBoundingClientRect().top < innerHeight*.35) k=i; }); links.forEach((a,i)=>a.classList.toggle("on",i===k));
  const r=main.getBoundingClientRect(); document.getElementById("prog").style.width=Math.min(100,Math.max(0,(innerHeight*.35-r.top)/r.height*100))+"%"; }
addEventListener("scroll",sync,{passive:true}); sync();
</script></Fragment>
