---
import Base from '../../layouts/Base.astro';
import '@fontsource/inter/600.css';
---
<Base title={'Kommunalka — case study · Aleksandra Zianchurina'} description={'Two visual concepts for a book festival: a poster, announcements and social media posts'} mobile={true}>
<Fragment slot="head"><style is:inline>
  :root { --bg:#fff; --ink:#0f0f0f; --muted:#8b8b8b; --line:#e8e6e1; --pad:clamp(16px,2.2vw,32px); --gap:24px;
          --s-milk:#fffef9; --s-ink:#101010; --s-lime:#e2e881; --s-coral:#f86d4e; --s-blue:#a8bcff; --s-peach:#fce5d7; }
  html, body { overflow-x:clip; }
  body, .cur .in { font-family:"PT Sans Narrow", system-ui, sans-serif; }
  .cur .in { font-size:16px; }
  .lab { font-size:13.5px; letter-spacing:.05em; text-transform:uppercase; }
  .mut { color:var(--muted); }
  .top { position:fixed; top:var(--pad); left:var(--pad); right:var(--pad); display:flex; justify-content:space-between; z-index:20; }
  .top nav { display:flex; gap:22px; }
  /* 12-column grid used everywhere */
  .g { display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); column-gap:var(--gap); padding:0 var(--pad); }
  .side { grid-column:1 / 4; } .main { grid-column:4 / 13; } .full { grid-column:1 / 13; }

  /* hero */
  .hero { padding-top:calc(var(--pad) + 120px); row-gap:0; }
  .hero h1 { font-weight:400; font-size:clamp(100px,14vw,240px); letter-spacing:-.02em; line-height:.8; margin-left:-.04em; }
  .hero .lead { font-size:clamp(26px,2.3vw,38px); line-height:1.1; letter-spacing:-.015em; max-width:22em; margin-top:28px; }
  .meta { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); column-gap:var(--gap); margin-top:44px; padding-top:16px; border-top:1px solid var(--ink); }
  .meta div { font-size:19px; line-height:1.25; } .meta .lab { display:block; margin-bottom:6px; }
  .cover { margin-top:72px; } 

  /* layout with sticky contents */
  .body { margin-top:120px; align-items:start; }
  .toc { position:sticky; top:calc(var(--pad) + 64px); }
  .toc .lab { display:block; margin-bottom:16px; }
  .toc ol { list-style:none; }
  .toc a { display:grid; grid-template-columns:2.4em 1fr; align-items:baseline; padding:4px 0; font-size:clamp(19px,1.45vw,24px); color:#c3c1ba; transition:color .2s; }
  .toc a .n { font-size:13.5px; letter-spacing:.05em; }
  .toc a.on { color:var(--ink); }
  .toc .prog { height:2px; background:var(--line); margin-top:20px; width:80%; position:relative; } .toc .prog i { position:absolute; inset:0 auto 0 0; background:var(--ink); width:0; }
  .toc a.all { display:inline-block; margin-top:28px; font-size:13.5px; color:var(--muted); }
  .toc a.all:hover { color:var(--ink); }

  section.ch { padding-bottom:160px; scroll-margin-top:calc(var(--pad) + 60px); }
  .ch-h { display:grid; grid-template-columns:repeat(9,minmax(0,1fr)); column-gap:var(--gap); margin-bottom:48px; }
  .ch-h .n { grid-column:1 / 10; margin-bottom:12px; }
  .ch-h h2 { grid-column:1 / 7; font-weight:400; font-size:clamp(46px,4.4vw,74px); letter-spacing:-.03em; line-height:.92; }
  .ch-h p { grid-column:1 / 7; font-size:clamp(22px,1.7vw,28px); line-height:1.15; color:var(--muted); margin-top:16px; }
  .txt { font-size:clamp(19px,1.35vw,22px); line-height:1.42; max-width:34em; }
  .txt.big { font-size:clamp(24px,1.9vw,31px); line-height:1.22; letter-spacing:-.01em; max-width:28em; }
  .kv { display:grid; grid-template-columns:repeat(9,minmax(0,1fr)); column-gap:var(--gap); row-gap:28px; margin-top:48px; }
  .kv dt { grid-column:1 / 3; padding-top:6px; color:var(--muted); }
  .kv dd { grid-column:3 / 9; font-size:clamp(19px,1.35vw,22px); line-height:1.42; }
  h3 { font-weight:400; font-size:clamp(28px,2.2vw,36px); letter-spacing:-.02em; margin:88px 0 18px; }
  .entry { margin-top:20px; display:flex; flex-wrap:wrap; gap:8px; align-items:center; font-size:18px; color:var(--muted); }
  .entry span { border:1px solid var(--line); border-radius:999px; padding:4px 12px 6px; color:var(--ink); }


  .cover.duo { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .cover.duo img { width:100%; display:block; aspect-ratio:4/5; object-fit:cover; }
  .note { margin-top:12px; font-size:18px; line-height:1.38; color:var(--muted); max-width:40em; }
  /* a caption belongs to the pictures above it: the next group of pictures starts after a bigger gap */
  .note + .pair, .note + .row3, .note + .row5, .note + .wide { margin-top:56px; }
  .pair { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:8px; }
  .pair img, .row3 img, .row5 img, .wide img { width:100%; display:block; }
  .row3 { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin-top:10px; }
  .row5 { display:grid; grid-template-columns:1fr 1fr 1fr .8fr .8fr; align-items:start; gap:10px; margin-top:10px; }
  .wide { margin-top:10px; }
  .idea { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--gap); margin:0 0 32px; }
  .idea div { border-top:1px solid var(--ink); padding-top:12px; font-size:18px; line-height:1.38; }
  .idea .lab { display:block; color:var(--muted); margin-bottom:6px; }
  .next { display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); column-gap:var(--gap); padding:48px var(--pad) var(--pad); border-top:1px solid var(--ink); align-items:end; }
  .next .t { grid-column:1 / 7; } .next .t div:last-child { font-weight:400; font-size:clamp(76px,9.5vw,160px); letter-spacing:-.02em; line-height:.82; margin-top:16px; }
  .next img { grid-column:7 / 13; width:100%; aspect-ratio:16/9; object-fit:cover; display:block; }
  @media (max-width:900px){ .side{display:none} .main{grid-column:1/13} .idea,.row5{grid-template-columns:1fr 1fr} .kv dt,.kv dd{grid-column:1/10} }
  /* collab ribbon from alё: light blue tape with the joint mark */
  .ribbon { display:flex; gap:2.2em; overflow:hidden; white-space:nowrap; background:#b9e1f0; color:#1d1d1d; font-family:"Inter",sans-serif; font-weight:600; font-size:clamp(18px,1.8vw,28px); padding:.5em 0; margin-top:48px; }
  .ribbon span { flex:none; padding-left:1.1em; }
  .collab { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; margin-top:10px; }
  .collab img { width:100%; aspect-ratio:4/5; object-fit:cover; display:block; }
  @media (max-width:900px){ .collab{grid-template-columns:1fr 1fr} }
</style></Fragment>
<div class="top lab"><a href="/en/">← Aleksandra&nbsp;Zianchurina</a><nav><a href="/en/">work</a><a href="/en/about/">about</a></nav></div>

<header class="g hero">
  <div class="side lab mut">08 / 08</div>
  <div class="main">
    <h1>Kommunalka</h1>
    <p class="lead">Two visual concepts for a book festival: a poster, announcements and social media posts</p>
    <div class="meta">
      <div><span class="lab mut">Role</span>Designer</div>
      <div><span class="lab mut">Year</span>2025</div>
      <div><span class="lab mut">Tools</span>Figma</div>
      <div><span class="lab mut">Deliverables</span>2&nbsp;concepts, posters, posts, stories</div>
    </div>
  </div>
  <div class="main cover duo"><img src="/img/komm/k1-poster.webp" alt="Concept 1: book poster"><img src="/img/komm/k2-poster1.webp" alt="Concept 2: poster with a string bag"></div>
</header>

<div class="g body">
  <aside class="side toc" data-native><span class="lab mut">Contents</span><ol id="toc"></ol><div class="prog"><i id="prog"></i></div><a href="/en/" class="all lab mut">← all work</a></aside>
  <main class="main" id="main" data-native>

  <section class="ch" id="about" data-t="About the project">
    <div class="ch-h"><h2><span class="n">01</span>About the project</h2><p>A book festival of independent publishers: a market, a garage sale and talks.</p></div>
    <p class="txt big">The festival’s idea is a book community in the spirit of a Saint Petersburg kommunalka (communal apartment): neighbors, friends and conversations in the kitchen. I proposed two ways to tell this story visually.</p>
    <dl class="kv"><dt class="lab">Brief</dt><dd>Visuals, a poster and merch in time for the festival, July 26–⁠27, 2025.</dd></dl>
  </section>

  <section class="ch" id="c1" data-t="Concept 1 / Book">
    <div class="ch-h"><h2><span class="n">02</span>Concept 1 / Book</h2><p>The name assembled from the spines of participating publishers’ books.</p></div>
    <div class="idea">
      <div><span class="lab">Imagery</span>The festival as one big book, with the participants as bookmarks and spines slipped between the letters</div>
      <div><span class="lab">Typeface</span>A large bold grotesque, the name split into syllables: KOM / MU / NA / LKA</div>
      <div><span class="lab">Color</span>Black, white and gray noise; the bright accents come from publishers’ covers</div>
    </div>
    <div class="pair"><img src="/img/komm/k1-poster.webp" alt="" loading="lazy"><img src="/img/komm/k1-members.webp" alt="" loading="lazy"></div>
    <div class="wide"><img src="/img/komm/k1-carousel.webp" alt="“Participants” carousel" loading="lazy"></div>
    <p class="note">The “Participants” carousel: the name stretches across all the slides, and the publishers’ spines slot into the letters.</p>
    <div class="row3"><img src="/img/komm/k1-sale.webp?v=2" alt="" loading="lazy"><img src="/img/komm/k1-fest.webp" alt="" loading="lazy"><img src="/img/komm/k1-lect.webp" alt="" loading="lazy"></div>
  </section>

  <section class="ch" id="c2" data-t="Concept 2 / Kitchen">
    <div class="ch-h"><h2><span class="n">03</span>Concept 2 / Kitchen</h2><p>Everyday life in a communal apartment, drawn by hand.</p></div>
    <div class="idea">
      <div><span class="lab">Imagery</span>Objects from the shared kitchen and rooms: a string bag, a lamp, an armchair, a sofa — painted with a brush</div>
      <div><span class="lab">Typeface</span>Condensed caps with wide letter spacing, like on old posters and shop signs</div>
      <div><span class="lab">Color</span>Blue, milky white and black, with a torn paper edge</div>
    </div>
    <div class="pair"><img src="/img/komm/k2-poster1.webp" alt="" loading="lazy"><img src="/img/komm/k2-poster2.webp" alt="" loading="lazy"></div>
    <p class="note">Printed festival posters: light and dark versions.</p>
    <div class="row5"><img src="/img/komm/k2-fest.webp" alt="" loading="lazy"><img src="/img/komm/k2-program.webp?v=2" alt="" loading="lazy"><img src="/img/komm/k2-sale.webp" alt="" loading="lazy"><img src="/img/komm/k2-partners.webp" alt="" loading="lazy"><img src="/img/komm/k2-members.webp" alt="" loading="lazy"></div>
    <p class="note">Posts: announcement, talks program, garage sale, partners and participants.</p>
  </section>

  <section class="ch" id="result" data-t="Results">
    <div class="ch-h"><h2><span class="n">04</span>Results</h2><p>Two different ideas for one brief, plus a merch collaboration.</p></div>
    <dl class="kv" style="margin-top:0"><dt class="lab">What it shows</dt><dd>The same idea — a book community as a kommunalka — can be told in two different visual languages: through typography and publishers’ spines, or through hand-drawn everyday life. Both concepts are built into a system: poster, announcements, carousel and stories.</dd>
      <dt class="lab">Collaboration</dt><dd>For the festival, my knitwear brand <a class="inl" href="/en/ale/">alё&nbsp;→</a> made string bags and keychains with a shared “alё&nbsp;x&nbsp;КОММУНАЛКА” ribbon.</dd></dl>
    <div class="ribbon" aria-label="alё × Kommunalka ribbon"><span>alё x КОММУНАЛКА</span><span>alё x КОММУНАЛКА</span><span>alё x КОММУНАЛКА</span><span>alё x КОММУНАЛКА</span></div>
    <div class="collab"><img src="/img/ale/collab-bag.webp" alt="Blue string bag with the alё × Kommunalka ribbon" loading="lazy"><img src="/img/ale/collab-key.webp" alt="Key chain with a carabiner and ribbon" loading="lazy"><img src="/img/ale/collab-pile.webp" alt="Key chains for the festival" loading="lazy"><img src="/img/ale/collab-phone.webp" alt="String bags, ribbons and an old phone" loading="lazy"></div>
  </section>
  </main>
</div>

<a class="next" href="/en/napokaz/"><div class="t"><div class="lab mut">Next case / 01</div><div>Napokaz →</div></div><img src="/img/home/napokaz-cov.webp" alt=""></a>
<Fragment slot="scripts"><script is:inline>
const two = i => String(i).padStart(2,"0");
const secs=[...document.querySelectorAll("section.ch")], toc=document.getElementById("toc");
toc.innerHTML = secs.map((s,i)=>`<li><a href="#${s.id}"><span class="n">${two(i+1)}</span>${s.dataset.t}</a></li>`).join("");
const links=[...toc.querySelectorAll("a")], main=document.getElementById("main");
function sync(){ let k=0; secs.forEach((s,i)=>{ if(s.getBoundingClientRect().top < innerHeight*.35) k=i; }); links.forEach((a,i)=>a.classList.toggle("on",i===k));
  const r=main.getBoundingClientRect(); document.getElementById("prog").style.width=Math.min(100,Math.max(0,(innerHeight*.35-r.top)/r.height*100))+"%"; }
addEventListener("scroll",sync,{passive:true}); sync();
</script></Fragment>
</Base>
