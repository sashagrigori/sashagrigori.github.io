---
import Base from '../../layouts/Base.astro';

---
<Base title={'About — Aleksandra Zianchurina'} description={'UI/UX designer with a background in sociology and four years in recruiting. Saint Petersburg, remote, open to work.'} mobile={true}>
<Fragment slot="head"><style is:inline>
  :root { --bg:#fff; --ink:#0f0f0f; --muted:#8b8b8b; --line:#e8e6e1; --pad:clamp(16px,2.2vw,32px); --gap:24px; --head:72px; }
  html, body { overflow-x:clip; }
  body, .cur .in { font-family:"PT Sans Narrow", system-ui, sans-serif; }
  .cur .in { font-size:16px; }
  .lab { font-size:13.5px; letter-spacing:.05em; text-transform:uppercase; } .mut { color:var(--muted); }
  img { display:block; width:100%; height:auto; }

  /* header: plain white bar, no blending → no repaint lag */
  .top { position:fixed; inset:0 0 auto 0; height:var(--head); z-index:20; display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); column-gap:var(--gap); align-items:center; padding:0 var(--pad); background:var(--bg); transition:background .3s, color .3s; }
  .top .nm { grid-column:1 / 4; } .top nav { grid-column:4 / 13; display:flex; justify-content:flex-end; gap:22px; }
  html[data-v="c"] .top:not(.solid) { background:transparent; color:#fff; }

  /* one grid for the whole page — same as the case page */
  .g { display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); column-gap:var(--gap); padding:0 var(--pad); }
  .side { grid-column:1 / 4; } .main { grid-column:4 / 13; }
  .sub { display:grid; grid-template-columns:repeat(9,minmax(0,1fr)); column-gap:var(--gap); }

  .word { font-weight:400; letter-spacing:-.02em; line-height:.82; }
  .intro { font-size:clamp(26px,2.3vw,38px); line-height:1.06; letter-spacing:-.018em; }
  .facts { display:flex; flex-wrap:wrap; margin-top:28px; }
  .facts { gap:0; }
  .facts span + span::before { content:"/"; margin:0 .7em; }

  /* hero A — portrait | text, both the same height */
  .hero-a { padding-top:calc(var(--head) + 48px); }
  .hero-a .ph { grid-column:1 / 6; } .hero-a .ph img { aspect-ratio:4/5; object-fit:cover; object-position:50% 28%; max-height:calc(100vh - var(--head) - 96px); }
  .hero-a .tx { grid-column:7 / 13; display:flex; flex-direction:column; justify-content:space-between; }
  .hero-a .word { font-size:clamp(100px,14vw,240px); }
  /* hero B — name across, intro + small portrait */
  .hero-b { padding-top:calc(var(--head) + 48px); row-gap:40px; }
  .hero-b .word { grid-column:1 / 13; font-size:clamp(100px,14vw,240px); }
  .hero-b .tx { grid-column:1 / 8; }
  .hero-b .ph { grid-column:10 / 13; } .hero-b .ph img { aspect-ratio:3/4; object-fit:cover; object-position:50% 28%; }
  /* hero C — full-bleed film frame */
  .hero-c { position:relative; height:100vh; color:#fff; isolation:isolate; align-content:end; padding-bottom:calc(var(--pad) + 16px); }
  .hero-c > img { position:absolute; inset:0; height:100%; object-fit:cover; z-index:-1; filter:brightness(.7); }
  .hero-c .word { grid-column:1 / 13; font-size:clamp(100px,14vw,240px); margin-bottom:32px; }
  .hero-c .tx { grid-column:1 / 9; }

  /* sections */
  section { margin-top:clamp(120px,14vh,180px); }
  .side h2 { font-weight:400; font-size:clamp(34px,3vw,50px); letter-spacing:-.025em; line-height:.95; display:flex; gap:.35em; }
  .side h2 .n { color:#c3c1ba; }
  .path .row { padding:0 0 36px; align-items:baseline; }
  .path .y { grid-column:1 / 3; font-size:clamp(19px,1.35vw,22px); }
  .path .w { grid-column:3 / 6; font-size:clamp(22px,1.7vw,26px); letter-spacing:-.01em; line-height:1.1; }
  .path .w small { display:block; font-size:16px; color:var(--muted); margin-top:6px; letter-spacing:0; line-height:1.3; }
  .path .d { grid-column:6 / 10; font-size:18px; line-height:1.4; }
  .how .st { grid-column:span 3; }
  .how b { display:block; font-weight:400; font-size:44px; letter-spacing:-.02em; line-height:.9; }
  .how h3 { font-weight:400; font-size:clamp(28px,2.2vw,36px); margin:14px 0 8px; }
  .how p { font-size:18px; line-height:1.4; }
  .how .tools { margin-top:14px; color:var(--muted); }
  .free p { font-size:clamp(22px,1.7vw,28px); line-height:1.15; max-width:26em; }

  /* film: always inside the content columns */
  .film { margin-top:40px; display:grid; grid-template-columns:1fr 1fr; gap:var(--gap); align-items:start; }
  .film-a { display:flex; gap:var(--gap); overflow-x:auto; padding-bottom:10px; scroll-snap-type:x mandatory; scrollbar-width:thin; }
  .film-a img { height:clamp(300px,46vh,460px); width:auto; flex:none; scroll-snap-align:start; }
  .film-b { columns:2; column-gap:var(--gap); } .film-b img { margin-bottom:var(--gap); break-inside:avoid; }
  .film-c { display:flex; flex-direction:column; gap:var(--gap); }

  /* contacts */
  .contact { margin-top:clamp(140px,16vh,200px); background:var(--ink); color:#fff; padding-top:72px; padding-bottom:var(--pad); row-gap:72px; align-items:end; }
  .contact h2 { grid-column:1 / 7; font-weight:400; font-size:clamp(76px,9.5vw,160px); letter-spacing:-.02em; line-height:.8; }
  .contact .ln { grid-column:7 / 13; }
  .contact .ln a { display:flex; justify-content:space-between; font-size:clamp(22px,1.7vw,28px); padding:8px 0; }
  .contact .ln a:hover { color:#bdbdbd; }
  .contact .pc { grid-column:1 / 4; display:none; } html[data-v="c"] .contact .pc { display:block; }
  .contact .pc img { aspect-ratio:3/4; object-fit:cover; object-position:50% 28%; }
  .contact .foot { grid-column:1 / 13; display:flex; justify-content:space-between; color:#8a8a8a; }
  @media (max-width:900px){ .side,.main,.hero-a .ph,.hero-a .tx,.hero-b .tx,.hero-b .ph,.hero-c .tx,.contact h2,.contact .ln{grid-column:1/13} .how .st{grid-column:1/10} .film-b{columns:1} }
</style></Fragment>
<header class="top lab"><a class="nm" href="/en/">Aleksandra&nbsp;Zianchurina</a><nav><a href="/en/">work</a><a href="/en/about/">about</a></nav></header>
<div id="hero"></div>

<section class="g">
  <div class="side"><h2><span class="n">01</span>Path</h2></div>
  <div class="main path" data-native>
    <div class="row sub"><span class="y">2021</span><span class="w">Saint Petersburg State University<small>BA in Sociology</small></span><span class="d">Quantitative and qualitative research for real clients at the university’s Sociological Clinic of Applied Research.</span></div>
    <div class="row sub"><span class="y">2021–⁠2025</span><span class="w">Recruiting<small>Skyeng, HIVE, Yandex Crowd, Zoon</small></span><span class="d">Hundreds of interviews, including in English; hiring and onboarding surveys; funnel analytics; a knowledge base and training for colleagues. Volume and targeted hiring, including IT.</span></div>
    <div class="row sub"><span class="y">2024&nbsp;— now</span><span class="w">Freelance<small>UI/UX and graphic designer</small></span><span class="d">I run research, design interfaces in Figma and build them into working products with Claude Code. I also create brand identities and social media visuals. Courses: Yandex Practicum, WANNABE.</span></div>
  </div>
</section>

<section class="g">
  <div class="side"><h2><span class="n">02</span>How&nbsp;I&nbsp;work</h2></div>
  <div class="main sub how" data-native>
    <div class="st"><b>01</b><h3>Research</h3><p>Interviews, surveys, competitor analysis. First I find out who the people are and what they already do.</p><p class="tools lab">Interviews / surveys / JTBD</p></div>
    <div class="st"><b>02</b><h3>Design</h3><p>User flows, a screen map, wireframes, a design system. Every decision has a reason.</p><p class="tools lab">Figma / prototypes / UI kit</p></div>
    <div class="st"><b>03</b><h3>Build</h3><p>I take it to a working product with an AI agent: I set the tasks, review the results and watch the first users.</p><p class="tools lab">Claude Code / English C1</p></div>
  </div>
</section>

<section class="g">
  <div class="side"><h2><span class="n">03</span>Outside work</h2></div>
  <div class="main free" data-native><p>I shoot on film, watch a lot of movies and go to exhibitions.</p><div class="film" id="film"></div></div>
</section>

<footer class="g contact">
  <h2>Get in<br>touch</h2>
  <div class="ln lab"><a href="https://t.me/sashagrigori" target="_blank" rel="noopener">Telegram <span>↗</span></a><a href="mailto:grigoreva.asd@gmail.com">Email <span>↗</span></a><a href="https://www.behance.net/sashagrigori" target="_blank" rel="noopener">Behance <span>↗</span></a><a href="https://www.linkedin.com/in/sashagrigori/" target="_blank" rel="noopener">LinkedIn <span>↗</span></a></div>
  <div class="pc"><img src="/img/about/portrait.jpg" alt=""></div>
  <div class="foot lab"><span>Saint Petersburg / remote</span><span>© 2026&nbsp;Aleksandra Zianchurina</span></div>
</footer>
<Fragment slot="scripts"><script is:inline>
const INTRO=`I’m Sasha, a UI/UX designer with a background in sociology. I start with people and take ideas all the way to a working product: I research, design in Figma and build in code with AI.`;
const FACTS=`<div class="facts lab"><span>Saint Petersburg</span><span>Remote</span><span>Open to work</span></div>`;
document.getElementById("hero").className="g hero-a";
document.getElementById("hero").innerHTML=`<figure class="ph"><img src="/img/about/portrait.jpg" alt="Sasha"></figure><div class="tx"><div class="word">About</div><div><p class="intro">${INTRO}</p>${FACTS}</div></div>`;
document.getElementById("film").innerHTML=["f-hand","f-road"].map(f=>`<div class="ph"><img src="/img/about/${f}.jpg" alt="" loading="lazy"></div>`).join("");
</script></Fragment>
</Base>
