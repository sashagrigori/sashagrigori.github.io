---
import Base from '../../layouts/Base.astro';
import '@fontsource/wix-madefor-text/400.css';
import '@fontsource/wix-madefor-text/500.css';
---
<Base title={'Napokaz — case study · Aleksandra Zianchurina'} description={'A diary of cultural experiences: from 8 interviews to a live service'} mobile={true}>
<Fragment slot="head"><style is:inline>
  :root { --bg:#fff; --ink:#0f0f0f; --muted:#8b8b8b; --line:#e8e6e1; --pad:clamp(16px,2.2vw,32px); --gap:24px;
          --n950:#141414; --n900:#1b1a18; --n800:#2a2824; --cream:#fff2d8; --taupe:#898376; }
  html, body { overflow-x:clip; }
  body, .cur .in { font-family:"PT Sans Narrow", system-ui, sans-serif; }
  .cur .in { font-size:16px; }
  .lab { font-size:13.5px; letter-spacing:.05em; text-transform:uppercase; }
  .mut { color:var(--muted); }
  .top { position:fixed; top:var(--pad); left:var(--pad); right:var(--pad); display:flex; justify-content:space-between; z-index:20; }
  .top nav { display:flex; gap:22px; }
  /* 12-column grid used everywhere */
  .g { display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); column-gap:var(--gap); padding:0 var(--pad); }
  .side { grid-column:1 / 4; } .main { grid-column:4 / 13; } .full { grid-column:1 / 13; }

  /* hero */
  .hero { padding-top:calc(var(--pad) + 120px); row-gap:0; }
  .hero h1 { font-weight:400; font-size:clamp(100px,14vw,240px); letter-spacing:-.02em; line-height:.8; margin-left:-.04em; }
  .hero .lead { font-size:clamp(26px,2.3vw,38px); line-height:1.1; letter-spacing:-.015em; max-width:22em; margin-top:28px; }
  .meta { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); column-gap:var(--gap); margin-top:44px; padding-top:16px; border-top:1px solid var(--ink); }
  .meta div { font-size:19px; line-height:1.25; } .meta .lab { display:block; margin-bottom:6px; }
  .cover { margin-top:72px; }
  .cover .pic { width:100%; height:auto; display:block; background:var(--n950); }
  .cover .art { background:var(--n950); color:var(--cream); aspect-ratio:21/9; display:grid; place-items:center; align-content:center; gap:28px; }
  .cover .art img { width:min(62%,900px); height:auto; display:block; }
  .cover .art .lab { color:var(--cream); opacity:.85; font-family:"Wix Madefor Text"; letter-spacing:.08em; font-size:clamp(12px,1.1vw,16px); }

  /* layout with sticky contents */
  .body { margin-top:120px; align-items:start; }
  .toc { position:sticky; top:calc(var(--pad) + 64px); }
  .toc .lab { display:block; margin-bottom:16px; }
  .toc ol { list-style:none; }
  .toc a { display:grid; grid-template-columns:2.4em 1fr; align-items:baseline; padding:4px 0; font-size:clamp(19px,1.45vw,24px); color:#c3c1ba; transition:color .2s; }
  .toc a .n { font-size:13.5px; letter-spacing:.05em; }
  .toc a.on { color:var(--ink); }
  .toc .prog { height:2px; background:var(--line); margin-top:20px; width:80%; position:relative; } .toc .prog i { position:absolute; inset:0 auto 0 0; background:var(--ink); width:0; }
  .toc a.all { display:inline-block; margin-top:28px; font-size:13.5px; color:var(--muted); }
  .toc a.all:hover { color:var(--ink); }

  section.ch { padding-bottom:160px; scroll-margin-top:calc(var(--pad) + 60px); }
  .ch-h { display:grid; grid-template-columns:repeat(9,minmax(0,1fr)); column-gap:var(--gap); margin-bottom:48px; }
  .ch-h .n { grid-column:1 / 10; margin-bottom:12px; }
  .ch-h h2 { grid-column:1 / 7; font-weight:400; font-size:clamp(46px,4.4vw,74px); letter-spacing:-.03em; line-height:.92; }
  .ch-h p { grid-column:1 / 7; font-size:clamp(22px,1.7vw,28px); line-height:1.15; color:var(--muted); margin-top:16px; }
  .txt { font-size:clamp(19px,1.35vw,22px); line-height:1.42; max-width:34em; }
  .txt + .txt { margin-top:16px; }
  .txt.big { font-size:clamp(24px,1.9vw,31px); line-height:1.22; letter-spacing:-.01em; max-width:28em; }
  .kv { display:grid; grid-template-columns:repeat(9,minmax(0,1fr)); column-gap:var(--gap); row-gap:28px; margin-top:48px; }
  .kv dt { grid-column:1 / 3; padding-top:6px; color:var(--muted); }
  .kv dd { grid-column:3 / 9; font-size:clamp(19px,1.35vw,22px); line-height:1.42; }
  h3 { font-weight:400; font-size:clamp(28px,2.2vw,36px); letter-spacing:-.02em; margin:88px 0 18px; }

  /* tables */
  table { width:100%; border-collapse:collapse; margin-top:28px; font-size:18px; }
  th { text-align:left; font-weight:400; padding:0 16px 12px 0; vertical-align:bottom; }
  td { padding:13px 16px 13px 0; border-top:1px solid var(--line); vertical-align:top; line-height:1.3; }
  td:first-child { color:var(--muted); }
  tr.hl td { color:var(--ink); background:#f6f5f2; } tr.hl td:first-child { color:var(--ink); padding-left:10px; }
  .y { font-size:18px; } .no-v { color:#c9c7c0; }

  /* segments / hypotheses */
  .cards { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; margin-top:8px; }
  .card { border:1px solid var(--line); padding:20px 20px 24px; display:flex; flex-direction:column; gap:12px; min-height:340px; }
  .card.core { background:var(--ink); border-color:var(--ink); color:#fff; }
  .card b { font-weight:400; font-size:clamp(22px,1.7vw,26px); letter-spacing:-.02em; line-height:1; }
  .card .share { font-weight:400; font-size:40px; letter-spacing:-.02em; line-height:.9; }
  .card p { font-size:18px; line-height:1.35; }
  .card .need { margin-top:auto; color:var(--muted); line-height:1.35; }
  .card.core .need, .card.core .lab.mut { color:#9a9a9a; }
  .pill { display:inline-block; width:max-content; font-size:12.5px; letter-spacing:.06em; text-transform:uppercase; padding:3px 10px 5px; border:1px solid var(--ink); border-radius:999px; white-space:nowrap; }
  .pill.on { background:var(--ink); color:#fff; } .pill.off { border-color:#c9c7c0; color:var(--muted); }
  .hyps { margin-top:8px; }
  .hyp { display:grid; grid-template-columns:repeat(9,minmax(0,1fr)); column-gap:var(--gap); align-items:baseline; padding:18px 0 20px; border-top:1px solid var(--line); }
  .hyp .n { grid-column:1 / 2; } .hyp p { grid-column:2 / 7; font-size:clamp(22px,1.7vw,26px); line-height:1.25; }
  .hyp .r { grid-column:7 / 10; display:flex; flex-direction:column; gap:6px; align-items:flex-start; }
  .cols3 { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--gap); margin-top:28px; }
  .cols3 ul { list-style:none; margin-top:16px; } .cols3 li { font-size:clamp(19px,1.35vw,22px); line-height:1.5; }
  .have { list-style:none; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:var(--gap); margin-top:20px; }
  .have li { padding:12px 0 14px; border-top:1px solid var(--line); font-size:clamp(19px,1.35vw,22px); line-height:1.35; }

  /* dark panels: wireframes, palette, components */
  .panel { background:var(--n950); color:var(--cream); padding:clamp(24px,3vw,48px); margin-top:28px; }
  .wfs { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:clamp(20px,2.4vw,40px) clamp(16px,2vw,32px); }
  .wfs figure img { width:100%; height:auto; display:block; }
  .wfs figcaption { margin-top:14px; } .wfs figcaption b { display:block; font-weight:400; font-size:clamp(22px,1.7vw,26px); margin-bottom:4px; }
  .wfs figcaption span { font-size:16px; line-height:1.3; color:#b9b3a6; display:block; }
  .variants { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:var(--gap); margin-top:28px; }
  .variants figure img { width:100%; display:block; }
  .variants figcaption { display:flex; justify-content:space-between; align-items:center; gap:8px; margin-top:12px; font-size:18px; }
  .variants figure.pick img { outline:2px solid var(--ink); outline-offset:6px; }
  .variants figure:not(.pick) img { opacity:.55; }

  /* scenario */
  .flow { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:var(--gap); margin-top:8px; align-items:start; }
  .flow .shot { aspect-ratio:400/869; display:flex; align-items:center; justify-content:center; }
  .flow .shot img { width:100%; height:100%; object-fit:contain; display:block; }
  .flow .shot.go { background:#f6f5f2; flex-direction:column; gap:10px; }
  .flow .go span { font-size:15px; letter-spacing:.04em; text-transform:uppercase; padding:4px 10px 6px; border-radius:999px; color:var(--n950); }
  .flow .st-n { font-weight:400; font-size:40px; letter-spacing:-.02em; margin-top:18px; line-height:1; }
  .flow b { display:block; font-weight:400; font-size:24px; margin:6px 0 6px; }
  .flow p { font-size:18px; line-height:1.35; }
  .vids { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--gap); margin-top:40px; }
  .vid { aspect-ratio:16/10; background:#f6f5f2; display:grid; place-items:center; color:var(--muted); }
  .desk { margin-top:40px; } .desk img { width:100%; display:block; } .desk figcaption { margin-top:12px; }

  /* design system */
  /* where the visual came from: identity vs service */
  /* identity → service: one scale for both columns, live samples (only Formular is a picture: the font is paid) */
  .origin { background:var(--n950); color:var(--cream); margin-top:8px; padding:clamp(20px,3vw,40px); }
  .origin .lab { color:#b9b3a6; }
  .o-hd, .o-row { display:grid; grid-template-columns:6em minmax(0,1fr) 28px minmax(0,1.3fr) minmax(0,.8fr); gap:20px; align-items:center; }
  .o-hd { padding-bottom:12px; }
  .o-row { padding:18px 0; border-top:1px solid #3a3731; }
  .o-s { min-height:64px; display:flex; flex-wrap:wrap; align-items:center; gap:10px; }
  .o-s .m { display:none; }
  .o-arr { font-size:28px; line-height:1; color:#b9b3a6; }
  .o-why { font-size:15px; line-height:1.35; color:#b9b3a6; }
  .o-formular { width:200px; height:56px; overflow:hidden; display:block; } .o-formular img { width:100%; display:block; }
  .o-wix { font-family:"Wix Madefor Text"; font-size:30px; line-height:1; text-transform:uppercase; }
  .o-ell, .o-pill { display:inline-flex; align-items:center; justify-content:center; font-family:"Wix Madefor Text"; font-size:12px; letter-spacing:.04em; text-transform:uppercase; white-space:nowrap; }
  .o-ell { width:104px; height:34px; border-radius:50%; border:1px solid var(--cream); }
  .o-ell.f { background:var(--cream); color:var(--n950); } .o-ell.p { box-shadow:0 0 0 4px var(--cream); font-weight:500; }
  .o-pill { width:112px; height:40px; border-radius:999px; background:var(--cream); color:var(--n950); }
  .o-pill.p { font-weight:500; -webkit-text-stroke:.4px var(--n950); }
  .o-sw { display:flex; gap:4px; align-items:center; } .o-sw i { width:22px; height:22px; display:block; } .o-sw i.ink { background:var(--n950); box-shadow:inset 0 0 0 1px #4a463f; } .o-sw b { width:4px; }
  .o-note { margin-top:18px; display:flex; gap:14px; align-items:center; flex-wrap:wrap; font-size:16px; color:#b9b3a6; } .o-note img { width:96px; display:block; }
  .band { display:grid; grid-template-columns:5fr 2fr 1.6fr 1.6fr 1.3fr; height:180px; margin-top:8px; }
  .band div { padding:14px; display:flex; flex-direction:column; justify-content:flex-end; font-family:"Wix Madefor Text"; font-size:13px; line-height:1.35; }
  .band div small { opacity:.65; font-size:11px; letter-spacing:.05em; text-transform:uppercase; }
  .cats { display:grid; grid-template-columns:repeat(9,minmax(0,1fr)); gap:8px; margin-top:8px; }
  .cats div { height:140px; padding:12px; display:flex; flex-direction:column; justify-content:flex-end; color:var(--n950); font-family:"Wix Madefor Text"; font-size:13px; text-transform:uppercase; letter-spacing:.03em; }
  .cats small { font-size:10.5px; opacity:.6; text-transform:uppercase; letter-spacing:.05em; }
  .type { display:grid; grid-template-columns:repeat(9,minmax(0,1fr)); column-gap:var(--gap); margin-top:8px; font-family:"Wix Madefor Text"; }
  .type .aa { grid-column:1 / 4; font-size:clamp(120px,12vw,200px); line-height:.85; letter-spacing:-.04em; }
  .type .rows { grid-column:4 / 10; }
  .type .rows div { display:grid; grid-template-columns:7em 1fr; align-items:baseline; gap:16px; padding:10px 0; border-top:1px solid var(--line); }
  .type .rows .k { font-family:"PT Sans Narrow"; font-size:13.5px; letter-spacing:.05em; text-transform:uppercase; color:var(--muted); }
  .comps { display:grid; grid-template-columns:repeat(9,minmax(0,1fr)); column-gap:var(--gap); align-items:start; }
  .comps .ui { grid-column:1 / 6; display:flex; flex-direction:column; gap:22px; font-family:"Wix Madefor Text"; }
  .comps .card-img { grid-column:6 / 10; } .comps .card-img img { width:100%; display:block; }
  .ui .row { display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
  /* components as in the service: button 48px, chip/tab 40px, icon button 44px, Lucide icons */
  .ui .btn { display:inline-flex; align-items:center; justify-content:center; height:48px; width:min(240px,100%); border-radius:999px; font-size:15px; letter-spacing:.02em; text-transform:uppercase; border:1px solid var(--cream); }
  .ui .btn.f { background:var(--cream); color:var(--n950); }
  .ui .chip { display:inline-flex; align-items:center; gap:6px; height:40px; padding:0 18px; border-radius:999px; font-size:13px; letter-spacing:.04em; text-transform:uppercase; border:1px solid var(--cream); }
  .ui .chip.f { background:var(--cream); color:var(--n950); }
  .ui .chip svg { width:16px; height:16px; flex:none; }
  .ui .chip.tab { padding:0 26px; }
  .ui .ib { display:inline-flex; align-items:center; justify-content:center; gap:6px; height:44px; min-width:44px; padding:0 10px; border-radius:999px; font-size:14px; }
  .ui .ib svg { width:20px; height:20px; }
  .ui .ib.on svg { fill:#ff6b57; color:#ff6b57; } .ui .ib.pin svg { fill:currentColor; }
  .ui .ib.prim { background:var(--cream); color:var(--n950); }
  .ui .field { border:1px solid #4a463f; padding:13px 14px; font-size:14px; color:#8d877b; }
  .ui .lab { color:#b9b3a6; font-family:"PT Sans Narrow"; }
  .ui .lab.cap { display:block; margin-bottom:10px; }
  .ui .stars { display:flex; gap:4px; } .ui .stars i, .ui .stars svg { width:22px; height:22px; display:block; } .ui .stars .fill svg { fill:currentColor; }
  .cats svg { width:18px; height:18px; margin-bottom:auto; }

  .next { display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); column-gap:var(--gap); padding:48px var(--pad) var(--pad); border-top:1px solid var(--ink); align-items:end; }
  .next .t { grid-column:1 / 7; } .next .t div:last-child { font-weight:400; font-size:clamp(76px,9.5vw,160px); letter-spacing:-.02em; line-height:.82; margin-top:16px; }
  .next img { grid-column:7 / 13; width:100%; aspect-ratio:16/9; object-fit:cover; display:block; }
  @media (max-width:900px){ .side{display:none} .main{grid-column:1/13} .cards,.wfs,.variants,.flow{grid-template-columns:1fr 1fr} .cats{grid-template-columns:repeat(3,1fr)} .kv dt,.kv dd{grid-column:1/10} .have{grid-template-columns:1fr} }
  /* scenarios */
  .scn { margin-top:72px; } .scn:first-of-type { margin-top:0; }
  .scn-h { display:grid; grid-template-columns:repeat(9,minmax(0,1fr)); column-gap:var(--gap); margin-bottom:28px; }
  .scn-h .lab { grid-column:1 / 10; }
  .scn-h h4 { grid-column:1 / 7; font-weight:400; font-size:clamp(28px,2.2vw,36px); letter-spacing:-.025em; line-height:1; margin:8px 0 10px; }
  .scn-h p { grid-column:1 / 7; font-size:clamp(19px,1.35vw,22px); line-height:1.35; color:var(--muted); }
  .scn-row { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:var(--gap); align-items:start; }
  /* phone screens at full width and one scale; 390:763 trims the safe area under the tab bar */
  .scn-row img, .vslot { width:100%; aspect-ratio:390/763; object-fit:cover; object-position:top; display:block; border-radius:14px; box-shadow:0 1px 2px rgba(0,0,0,.06), 0 12px 32px rgba(0,0,0,.08); }
  .scn-row video.clip { width:100%; aspect-ratio:390/763; object-fit:cover; object-position:top; display:block; border-radius:14px; background:#141414; box-shadow:0 1px 2px rgba(0,0,0,.06), 0 12px 32px rgba(0,0,0,.08); }
  .lvid video.clip { width:100%; aspect-ratio:1440/922; display:block; border-radius:12px; background:#141414; box-shadow:0 1px 2px rgba(0,0,0,.06), 0 12px 32px rgba(0,0,0,.08); }
  .vslot { box-shadow:none; background:#f4f3f0; border:1px dashed #cfccc4; display:grid; place-items:center; text-align:center; color:var(--muted); line-height:1.5; }
  .scn-row figcaption { margin-top:16px; font-size:18px; line-height:1.3; }
  .scn-row figcaption .lab { display:block; margin-bottom:6px; }
  .desk { margin-top:96px; } .desk img { width:100%; display:block; border-radius:12px; box-shadow:0 1px 2px rgba(0,0,0,.06), 0 12px 32px rgba(0,0,0,.08); } .desk figcaption { margin-top:14px; }
</style></Fragment>
<div class="top lab"><a href="/en/">← Aleksandra&nbsp;Zianchurina</a><nav><a href="/en/">work</a><a href="/en/about/">about</a></nav></div>

<header class="g hero">
  <div class="side lab mut">01 / 08</div>
  <div class="main">
    <h1>Napokaz</h1>
    <p class="lead">A diary of cultural experiences: from 8 interviews to a live service</p>
    <div class="meta">
      <div><span class="lab mut">Role</span>Creator, product designer</div>
      <div><span class="lab mut">Year</span>2026</div>
      <div><span class="lab mut">Tools</span>Figma, Claude Code</div>
      <div><span class="lab mut">Website</span><a class="inl" href="https://nenapokaz.ru" target="_blank" rel="noopener">nenapokaz.ru&nbsp;↗</a></div>
    </div>
  </div>
  <div class="full cover"><img class="pic" src="/img/case/cover.webp" width="1760" height="887" alt="Napokaz cover: an ellipse logo with a photo of the city inside, and the words “Impressions (on) show” and “A diary of cultural experiences” along the edges"></div>
</header>

<div class="g body">
  <aside class="side toc" data-native><span class="lab mut">Contents</span><ol id="toc"></ol><div class="prog"><i id="prog"></i></div><a href="/en/" class="all lab mut">← all work</a></aside>
  <main class="main" id="main" data-native>

  <section class="ch" id="about" data-t="About the project">
    <div class="ch-h"><h2><span class="n">01</span>About the project</h2><p>A web service where you record your impressions of culture and find where to go next on the advice of friends and acquaintances.</p></div>
    <p class="txt big">A diary of cultural experiences — for people who make culture part of their everyday life. In the diary, you record impressions of plays, concerts, exhibitions, lectures, books, films, music and more. A title, a rating and a couple of lines are enough.</p>
    <p class="txt" style="margin-top:20px">The ironic name, Napokaz (Russian for “for show”), takes the edge off snobbery and pretension and makes the brand friendlier. “Write it down for yourself. The rest is for show.”</p>
    <dl class="kv"><dt class="lab">Goal</dt><dd>Design and launch a service where you can quickly record an impression and easily find where to go, based on recommendations from people whose taste you trust.</dd>
      <dt class="lab">My role</dt><dd>Creator and product designer: research, product decisions, UI/UX, design system, landing page, copy. Claude Code, an AI agent, wrote the code to my specs; I set the tasks, made the decisions and signed off on the work.</dd></dl>
  </section>

  <section class="ch" id="research" data-t="Research">
    <div class="ch-h"><h2><span class="n">02</span>Research</h2><p>8 interviews and a review of five services where people keep their impressions today.</p></div>
    <p class="txt">Semi-structured interviews based on a 10-question guide: how people remember what they’ve seen, where they write it down, what they share and where they keep things “to see later”. Participants were acquaintances from different fields.</p>
    <h3>Competitors</h3>
    <table>
      <tr><th></th><th class="lab mut">What you log</th><th class="lab mut">Rating</th><th class="lab mut">Catalog</th><th class="lab mut">Friends</th><th class="lab mut">For later</th></tr>
      <tr><td>Letterboxd</td><td>Films</td><td class="y">✓</td><td class="y">✓</td><td class="y">✓</td><td>Watchlist</td></tr>
      <tr><td>Kinopoisk</td><td>Films and TV series</td><td class="y">✓</td><td class="y">✓</td><td>Partly</td><td>“Will watch”</td></tr>
      <tr><td>LiveLib</td><td>Books</td><td class="y">✓</td><td class="y">✓</td><td class="y">✓</td><td>“Want to read”</td></tr>
      <tr><td>Instagram</td><td>Anything, no structure</td><td class="no-v">—</td><td class="no-v">—</td><td class="y">✓</td><td>Saved</td></tr>
      <tr><td>Notes</td><td>Anything, no structure</td><td class="no-v">—</td><td class="no-v">—</td><td class="no-v">—</td><td>Manually</td></tr>
      <tr class="hl"><td>Napokaz</td><td>Plays, concerts, exhibitions, lectures, books, films, music, places and custom categories</td><td>0.5–⁠5</td><td class="y">✓</td><td class="y">✓</td><td>“Plans”</td></tr>
    </table>
    <p class="txt" style="margin-top:28px">Each service covers a single category or offers no structure at all. The open niche is one diary for your whole cultural life.</p>
  </section>

  <section class="ch" id="segments" data-t="Segments">
    <div class="ch-h"><h2><span class="n">03</span>Segments</h2><p>I group people by whether they already record their impressions, and where.</p></div>
    <div class="cards">
      <div class="card core"><span class="lab mut">Core audience</span><span class="share">4/8</span><b>Chroniclers</b><p>Already keep notes, but in different places: a Telegram channel, Notion, notes apps, film services.</p><span class="need lab">Needs: everything in one place, text with photos, privacy levels</span></div>
      <div class="card"><span class="lab mut">Hidden need</span><span class="share">1/8</span><b>Chat chroniclers</b><p>Tell their friends about everything and dig through chats to find things. They don’t feel any discomfort.</p><span class="need lab">Needs: to reread their own thoughts</span></div>
      <div class="card"><span class="lab mut">Low barrier to entry</span><span class="share">1/8</span><b>Want to, but never get around to it</b><p>Give up on keeping notes: one entry takes half an hour, and perfectionism gets in the way.</p><span class="need lab">Needs: an entry in a minute, finished later</span></div>
      <div class="card"><span class="lab mut">Not the target</span><span class="share">2/8</span><b>Consumers</b><p>Watch films and go to concerts, but don’t record anything and don’t regret it.</p><span class="need lab">Not the target audience at this stage</span></div>
    </div>
  </section>

  <section class="ch" id="hypotheses" data-t="Hypotheses and findings">
    <div class="ch-h"><h2><span class="n">04</span>Hypotheses and findings</h2><p>Six hypotheses: four confirmed, two partly.</p></div>
    <div class="hyps">
      <div class="hyp"><span class="n lab mut">01</span><p>Notes are scattered across different places, and people need a single diary</p><span class="r"><span class="pill on">Confirmed</span><span class="lab mut">5 of 8</span></span></div>
      <div class="hyp"><span class="n lab mut">02</span><p>A short form is enough: title, type and rating</p><span class="r"><span class="pill">Partly</span><span class="lab mut">People want both short and detailed</span></span></div>
      <div class="hyp"><span class="n lab mut">03</span><p>People keep a diary for themselves; being public is secondary</p><span class="r"><span class="pill">Partly</span><span class="lab mut">Both for themselves and for others</span></span></div>
      <div class="hyp"><span class="n lab mut">04</span><p>Recommendations from people matter more than algorithms</p><span class="r"><span class="pill on">Confirmed</span><span class="lab mut">6 of 8</span></span></div>
      <div class="hyp"><span class="n lab mut">05</span><p>People want a look back and statistics</p><span class="r"><span class="pill on">Confirmed</span><span class="lab mut">4 of 8</span></span></div>
      <div class="hyp"><span class="n lab mut">06</span><p>People are willing to log things after the fact</p><span class="r"><span class="pill on">Confirmed</span><span class="lab mut">4 of 8</span></span></div>
    </div>
    <h3>What made it into the product</h3>
    <div class="hyps">
      <div class="hyp"><span class="n lab mut">01</span><p>A single cultural diary</p><span class="r"><span class="pill on">Implemented</span></span></div>
      <div class="hyp"><span class="n lab mut">02</span><p>Reviews can be short or detailed</p><span class="r"><span class="pill on">Implemented</span></span></div>
      <div class="hyp"><span class="n lab mut">03</span><p>Separate privacy settings for reviews and for the profile</p><span class="r"><span class="pill on">Implemented</span></span></div>
      <div class="hyp"><span class="n lab mut">04</span><p>Friends’ impressions, with an option to add them to your own “Plans”</p><span class="r"><span class="pill on">Implemented</span></span></div>
      <div class="hyp"><span class="n lab mut">05</span><p>Statistics by month and year</p><span class="r"><span class="pill on">Implemented</span></span></div>
      <div class="hyp"><span class="n lab mut">06</span><p>You can log an event from long ago</p><span class="r"><span class="pill on">Implemented</span></span></div>
    </div>
    <h3>Usability testing</h3>
    <p class="txt">After launch, I tested the service with real users. Here’s what I added as a result:</p>
    <div class="hyps fixes">
      <div class="hyp"><span class="n lab mut">01</span><p>An “Other” category: users create their own, such as “Video games”</p></div>
      <div class="hyp"><span class="n lab mut">02</span><p>A “Music” category for albums and songs: three participants asked for it, as they currently have nowhere to rate music</p></div>
      <div class="hyp"><span class="n lab mut">03</span><p>An “Add yours” button right on a friend’s card: an impression of the same event in one tap</p></div>
    </div>
    <h3>Mentioned in interviews, but not there yet</h3>
    <ul class="have">
      <li>Entries without a rating</li>
      <li>Reminders about events in “Plans”</li>
      <li>Connecting external event listings for upcoming events</li>
      <li>Importing your catalog from other services</li>
    </ul>
  </section>

  <section class="ch" id="thinking" data-t="Wireframes">
    <div class="ch-h"><h2><span class="n">05</span>Wireframes</h2><p>Screen logic and wireframes first, visuals second.</p></div>
    <p class="txt">Before the visual design, I sketched out the screen logic: which screens there are, what’s on each one and where every action leads. From this map I built the wireframes — here are the eight key screens.</p>
    <div class="panel"><div class="wfs" id="wfs"></div></div>
  </section>

  <section class="ch" id="scenario" data-t="Scenarios">
    <div class="ch-h"><h2><span class="n">06</span>Scenarios</h2><p>Three main scenarios — from “I want to write it down” to “I want to share my taste”.</p></div>

    <div class="scn">
      <div class="scn-h"><span class="lab mut">Scenario 1</span><h4>Record an impression</h4><p>I’ve just come back from a play and want to write it down while it’s fresh — in a minute, from my phone.</p></div>
      <div class="scn-row">
        <figure><img src="/img/case/s-new.jpg?v=3" alt=""><figcaption><span class="lab mut">01</span>I choose what it was: the type, the item from the catalog, a rating and the date</figcaption></figure>
        <figure><video class="clip" src="/videos/create.mp4?v=3" poster="/videos/create.jpg?v=3" muted loop playsinline preload="none" data-auto aria-label="Creating a new impression, video"></video><figcaption><span class="lab mut">02</span>I add photos and a couple of lines — the fields open step by step</figcaption></figure>
        <figure><img src="/img/case/s-card-modern.jpg?v=3" alt=""><figcaption><span class="lab mut">03</span>The card is ready: photo, rating, date and text</figcaption></figure>
        <figure><img src="/img/case/s-diary-modern.jpg?v=3" alt=""><figcaption><span class="lab mut">04</span>The entry goes into the diary, which can be filtered by type</figcaption></figure>
      </div>
    </div>

    <div class="scn">
      <div class="scn-h"><span class="lab mut">Scenario 2</span><h4>Save a recommendation to “Plans”</h4><p>A friend went to a concert and wrote about it — I want to go too and not forget.</p></div>
      <div class="scn-row">
        <figure><video class="clip" src="/videos/post.mp4?v=3" poster="/videos/post.jpg?v=3" muted loop playsinline preload="none" data-auto aria-label="Liking, commenting on and adding a friend’s post “To plans”, video"></video><figcaption><span class="lab mut">01</span>In the feed, I like my friend’s impression, leave a comment and save it to “Plans”</figcaption></figure>
        <figure><img src="/img/case/s-object-aigel.jpg?v=3" alt=""><figcaption><span class="lab mut">02</span>The item page shows the average rating, reviews and a “To plans” button</figcaption></figure>
        <figure><img src="/img/case/s-plans-aigel.jpg?v=3" alt=""><figcaption><span class="lab mut">03</span>In “Plans”, you can see who recommended it and when it was added</figcaption></figure>
      </div>
    </div>

    <div class="scn">
      <div class="scn-h"><span class="lab mut">Scenario 3</span><h4>Share your taste</h4><p>Friends ask what to see — I send them a single link.</p></div>
      <div class="scn-row">
        <figure><img src="/img/case/s-collections-croatia.jpg?v=3" alt=""><figcaption><span class="lab mut">01</span>I gather impressions into a collection on my profile</figcaption></figure>
        <figure><img src="/img/case/s-collection-croatia.jpg?v=3" alt=""><figcaption><span class="lab mut">02</span>The collection opens via a link, and people can follow it separately from its author</figcaption></figure>
      </div>
    </div>

    <figure class="desk"><img src="/img/case/desk.jpg" alt=""><figcaption class="lab mut">The same diary on desktop</figcaption></figure>
  </section>

  <section class="ch" id="system" data-t="Design system">
    <div class="ch-h"><h2><span class="n">07</span>Design system</h2><p>A dark background, cream text and thin lines. Only the categories get color.</p></div>
    <p class="txt big">The visuals grew out of the brand identity I made for a coffee-shop cinema — <a class="inl" href="/en/kino/">“Cinema &amp; Coffee” →</a>. The service is named after it. I carried over the logo, palette and grid as they were, but the typeface and buttons had to be reworked for the interface.</p>
    <span class="lab mut" style="display:block;margin-top:40px">Identity and service</span>
    <div class="origin">
      <div class="o-hd"><span></span><span class="lab">Identity</span><span></span><span class="lab">Service</span><span class="lab">Why</span></div>
      <div class="o-row"><span class="lab o-k">Typeface</span><div class="o-s"><span class="lab m">Identity</span><span class="o-formular"><img src="/img/kino/font.webp" alt="Formular"></span></div><span class="o-arr" aria-hidden="true">→</span><div class="o-s"><span class="lab m">Service</span><span class="o-wix">Wix Madefor</span></div><p class="o-why">Formular is paid; Wix Madefor is free and supports Cyrillic</p></div>
      <div class="o-row"><span class="lab o-k">Buttons</span><div class="o-s"><span class="lab m">Identity</span><span class="o-ell f">Default</span><span class="o-ell p">Pressed</span></div><span class="o-arr" aria-hidden="true">→</span><div class="o-s"><span class="lab m">Service</span><span class="o-pill f">Default</span><span class="o-pill p">Pressed</span></div><p class="o-why">In a row, the ellipses blurred together; the pressed state is now bold text instead of a ring</p></div>
      <div class="o-row"><span class="lab o-k">Colors</span><div class="o-s"><span class="lab m">Identity</span><span class="o-sw"><i class="ink"></i><i style="background:#fff2d8"></i></span></div><span class="o-arr" aria-hidden="true">→</span><div class="o-s"><span class="lab m">Service</span><span class="o-sw"><i class="ink"></i><i class="ink" style="background:#1b1a18"></i><i class="ink" style="background:#2a2824"></i><i style="background:#fff2d8"></i><i style="background:#898376"></i><b></b><i style="background:#ff6b57"></i><i style="background:#ffb547"></i><i style="background:#8fd49b"></i><i style="background:#b4a2ff"></i></span></div><p class="o-why">An interface needs background levels, a disabled state and category colors</p></div>
      <div class="o-note"><img src="/img/kino/logo-cream.svg" alt="Napokaz"><span>The logo, the line grid and the two main colors carried over unchanged</span></div>
    </div>
    <span class="lab mut" style="display:block;margin-top:56px">Base</span>
    <div class="band">
      <div style="background:#141414;color:#fff2d8">Background<small>ink-950 / #141414</small></div>
      <div style="background:#1b1a18;color:#fff2d8">Surface<small>ink-900</small></div>
      <div style="background:#2a2824;color:#fff2d8">Highlight<small>ink-800</small></div>
      <div style="background:#fff2d8;color:#141414;box-shadow:inset 0 0 0 1px #ece3cf">Text and lines<small>cream-100</small></div>
      <div style="background:#898376;color:#141414">Secondary<small>taupe-500</small></div>
    </div>
    <span class="lab mut" style="display:block;margin-top:32px">Categories</span>
    <div class="cats" id="cats"></div>
    <h3>Typeface</h3>
    <div class="type"><div class="aa">Aa</div><div class="rows">
      <div><span class="k">Wix Madefor Text</span><span style="font-size:15px">Regular 400 / Medium 500</span></div>
      <div><span class="k">Display / 64</span><span style="font-size:clamp(34px,3vw,52px);text-transform:uppercase;letter-spacing:-.02em">Diary</span></div>
      <div><span class="k">Headline / 40</span><span style="font-size:clamp(24px,2vw,34px);text-transform:uppercase">New impression</span></div>
      <div><span class="k">Title / 24</span><span style="font-size:20px;text-transform:uppercase">Serbia through a foreigner’s eyes</span></div>
      <div><span class="k">Body / 16</span><span style="font-size:16px">A photo exhibition by a Russian emigrant in Novi Sad.</span></div>
      <div><span class="k">Label / 12</span><span style="font-size:12px;text-transform:uppercase;letter-spacing:.06em;font-weight:500">Exhibition</span></div>
    </div></div>
    <h3>Components</h3>
    <div class="panel"><div class="comps">
      <div class="ui">
        <div><span class="lab cap">Buttons</span><div class="row"><span class="btn f">Start a diary</span><span class="btn">Log in</span></div></div>
        <div><span class="lab cap">Category chips</span><div class="row" id="chips"></div></div>
        <div><span class="lab cap">Tabs</span><div class="row"><span class="chip tab f">Impressions</span><span class="chip tab">Collections</span><span class="chip tab">Plans</span></div></div>
        <div><span class="lab cap">Icon buttons</span><div class="row acts"><span class="ib" data-ico="heart">12</span><span class="ib on" data-ico="heart"></span><span class="ib" data-ico="message-circle">4</span><span class="ib" data-ico="bookmark"></span><span class="ib pin" data-ico="bookmark"></span><span class="ib prim" data-ico="plus"></span></div></div>
        <div><span class="lab cap">Title</span><div class="field">Play, book, place…</div></div>
        <div><span class="lab cap">Rating</span><span class="stars"><i data-ico="star" class="fill"></i><i data-ico="star" class="fill"></i><i data-ico="star" class="fill"></i><i data-ico="star" class="fill"></i><i data-ico="star"></i></span></div>
      </div>
      <div class="card-img"><img src="/img/case/c-card.png" alt=""></div>
    </div></div>
  </section>

  <section class="ch" id="landing" data-t="Landing page">
    <div class="ch-h"><h2><span class="n">08</span>Landing page</h2><p>A presentation page that explains the idea of the service and leads into the diary.</p></div>
    <p class="txt">Before you enter the service, there’s a landing page at <a class="inl" href="https://nenapokaz.ru" target="_blank" rel="noopener">nenapokaz.ru&nbsp;↗</a>. A flight through a letter, a gallery of words, chapters and a photo strip — this is how the page unfolds as you scroll. For people who have turned off motion in their system settings, there’s a calm version without animation.</p>
    <figure class="desk lvid" style="margin-top:40px"><video class="clip" src="/videos/landing.mp4" poster="/videos/landing.jpg" muted loop playsinline preload="none" data-auto aria-label="Scrolling through the nenapokaz.ru landing page, video"></video><figcaption class="lab mut">The nenapokaz.ru landing page in motion</figcaption></figure>
  </section>

  <section class="ch" id="result" data-t="Results">
    <div class="ch-h"><h2><span class="n">09</span>Results</h2><p>The service and the landing page are live. They already have their first ~20 real users and ~50 entries.</p></div>
    <dl class="kv" style="margin-top:0"><dt class="lab">Service</dt><dd><a class="inl" href="https://nenapokaz.ru/app" target="_blank" rel="noopener">nenapokaz.ru/app&nbsp;↗</a> Email sign-up and login, diary, feed, collections, plans, notifications, moderation, statistics. Installable as a PWA.</dd>
      <dt class="lab">Landing page</dt><dd><a class="inl" href="https://nenapokaz.ru" target="_blank" rel="noopener">nenapokaz.ru&nbsp;↗</a> Scroll animation and a calm version, SEO, legal documents, cookie consent.</dd>
      <dt class="lab">What’s next</dt><dd>Integration with external catalogs of events, films and books; notifications about events from “Plans”; video in entries, not just photos; new sections based on user needs — restaurants, video games and so on.</dd></dl>
  </section>
  </main>
</div>

