      <tr><td>Кинопоиск</td><td>Кино и&nbsp;сериалы</td><td class="y">✓</td><td class="y">✓</td><td>Частично</td><td>«Буду смотреть»</td></tr>
      <tr><td>LiveLib</td><td>Книги</td><td class="y">✓</td><td class="y">✓</td><td class="y">✓</td><td>«Хочу прочитать»</td></tr>
      <tr><td>Instagram</td><td>Что&nbsp;угодно, без&nbsp;структуры</td><td class="no-v">—</td><td class="no-v">—</td><td class="y">✓</td><td>Сохранённое</td></tr>
